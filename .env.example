# Google Gemini API key — https://aistudio.google.com/apikey
#
# The free tier is roughly 5 requests a MINUTE and a few dozen a day across the
# whole project, and one grounded answer costs 2-3 requests. Measured cost on the
# paid tier is about $0.0056 an answer, so ~$5.60 per thousand. Enable billing
# before this is shared with anyone.
GEMINI_API_KEY=your_gemini_api_key

# Optional. Defaults are gemini-2.5-flash with 3.5/3.6-flash as fallbacks.
# gemini-2.0-flash, which this app originally shipped on, HAS BEEN RETIRED.
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_FALLBACKS=gemini-3.5-flash,gemini-3.6-flash

# Optional. Where the moat is read from; defaults to the live Signal deploy.
# SIGNAL_DATA_BASE=https://the-signal-gamma.vercel.app
